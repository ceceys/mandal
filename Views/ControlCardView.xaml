<UserControl x:Class="Mandal.Views.ControlCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Mandal.Services"
             Margin="12,0,0,0" RenderTransformOrigin="0.5,0" Background="Transparent">
    <UserControl.RenderTransform>
        <RotateTransform Angle="-1"/>
    </UserControl.RenderTransform>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kart: alıntılarla aynı beyaz çerçeve, içi kâğıt -->
        <Border Grid.Row="1" Background="White" Padding="4" CornerRadius="2" Margin="0,-6,0,0"
                Effect="{StaticResource CardShadow}">
            <Border Background="{StaticResource PaperBrush}" Width="128" Height="164">
                <StackPanel VerticalAlignment="Center" Margin="4,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                            <Setter Property="Padding" Value="8,3"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </StackPanel.Resources>

                    <Button Style="{StaticResource CardButton}" Click="Capture_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource InkBrush}"
                                  Data="M4,7 L7,7 L9,4 L15,4 L17,7 L20,7 L20,19 L4,19 Z M12,16 A3.5,3.5 0 1 0 12,9 A3.5,3.5 0 1 0 12,16 Z"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding [Card_Capture], Source={x:Static svc:Loc.Current}}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CardButton}" Click="AddNote_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource InkBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5,4 L15,4 L19,8 L19,20 L5,20 Z M15,4 L15,8 L19,8 M8,12 L16,12 M8,16 L13,16"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding [Card_AddNote], Source={x:Static svc:Loc.Current}}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CardButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="16" Height="16">
                                <Line X1="1" Y1="4" X2="15" Y2="4" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="1" Y1="8" X2="15" Y2="8" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="1" Y1="12" X2="15" Y2="12" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse Canvas.Left="3.5" Canvas.Top="1.5" Width="5" Height="5" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.4"/>
                                <Ellipse Canvas.Left="8.5" Canvas.Top="5.5" Width="5" Height="5" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.4"/>
                                <Ellipse Canvas.Left="4.5" Canvas.Top="9.5" Width="5" Height="5" Fill="{StaticResource PaperBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.4"/>
                            </Canvas>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding [Card_Settings], Source={x:Static svc:Loc.Current}}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CardButton}" Click="Hide_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource InkBrush}" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,20 L12,5 M5,12 L12,5 L19,12"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding [Card_Hide], Source={x:Static svc:Loc.Current}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Tümünü sil: Kaldır'dan ayrı, bir satır aşağıda, ince çizgiyle -->
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="8,6,8,4"/>
                    <Button Style="{StaticResource CardButton}" Click="DeleteAll_Click" Foreground="{StaticResource DangerBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource DangerBrush}" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 L17,20 L18,7 M10,11 L10,17 M14,11 L14,17"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding [Card_DeleteAll], Source={x:Static svc:Loc.Current}}"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>
        </Border>

        <ContentControl Grid.Row="0" Template="{StaticResource PinTemplate}" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Panel.ZIndex="2" Margin="0,0,0,-6"/>
    </Grid>
</UserControl>
