<Window x:Class="Mandal.Views.LineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mandal.Views"
        xmlns:models="clr-namespace:Mandal.Models"
        Title="Mandal"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Left="0" Top="0" Height="206"
        SizeChanged="Window_SizeChanged" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <Style x:Key="NavArrow" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{StaticResource PaperBrush}" Stroke="#D9CBB3" StrokeThickness="1"
                                     Effect="{StaticResource CardShadow}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#EFE7D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Görünmez zemin: tüm ip bandı fareyi görür (giriş/çıkış sayımı için) -->
    <Grid x:Name="Root" Background="#01FFFFFF">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="-206"/>
        </Grid.RenderTransform>

        <!-- İp: gölge, ip, parlak kenar -->
        <Path x:Name="RopeShadow" Stroke="#38000000" StrokeThickness="6" IsHitTestVisible="False" Margin="0,3,0,0"/>
        <Path x:Name="Rope" Stroke="{StaticResource RopeBrush}" StrokeThickness="3" StrokeLineJoin="Round" IsHitTestVisible="False"/>
        <Path x:Name="RopeHighlight" Stroke="#66FFFFFF" StrokeThickness="1" IsHitTestVisible="False" Margin="0,-1,0,0"/>

        <!-- Uç kancalar -->
        <Ellipse Width="10" Height="10" Fill="#6B7280" Stroke="#40000000" StrokeThickness="1"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,23,0,0" IsHitTestVisible="False"/>
        <Ellipse Width="10" Height="10" Fill="#6B7280" Stroke="#40000000" StrokeThickness="1"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,6,0" IsHitTestVisible="False"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Alıntılar: görünmez ama giriş alan zemin (tekerlek kaydırması için) -->
            <ScrollViewer x:Name="Scroller" Grid.Column="0" Background="#01FFFFFF"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Margin="30,0,34,22" PanningMode="HorizontalOnly" Focusable="False"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel" ScrollChanged="Scroller_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Top" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ClipItem}">
                            <views:ClipItemView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Boş ip: ipe asılı not kartı -->
            <Grid x:Name="EmptyCard" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,0,0,0"
                  RenderTransformOrigin="0.5,0" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <RotateTransform Angle="1.5"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Background="White" Padding="4" CornerRadius="2" Margin="0,-6,0,0"
                        Effect="{StaticResource CardShadow}">
                    <Border Background="{StaticResource PaperBrush}" Padding="14,10" MaxWidth="360">
                        <TextBlock x:Name="EmptyText" Foreground="{StaticResource InkBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                    </Border>
                </Border>
                <ContentControl Grid.Row="0" Template="{StaticResource PinTemplate}" HorizontalAlignment="Center"
                                VerticalAlignment="Top" Panel.ZIndex="2" Margin="0,0,0,-6"/>
            </Grid>

            <!-- Kaydırma okları: taşan öğeler varsa görünür (slider gibi sayfa sayfa) -->
            <Button x:Name="LeftArrow" Grid.Column="0" Style="{StaticResource NavArrow}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="1,58,0,0" Click="LeftArrow_Click" Visibility="Collapsed">
                <Path Data="M9,3 L4,8 L9,13" Stroke="{StaticResource InkBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="14" Stretch="Uniform"/>
            </Button>
            <Button x:Name="RightArrow" Grid.Column="0" Style="{StaticResource NavArrow}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,58,4,0" Click="RightArrow_Click" Visibility="Collapsed">
                <Path Data="M4,3 L9,8 L4,13" Stroke="{StaticResource InkBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="14" Stretch="Uniform"/>
            </Button>

            <!-- Sağda sabit düğme kartı -->
            <views:ControlCardView Grid.Column="1" VerticalAlignment="Top" Margin="0,0,28,0"/>
        </Grid>
    </Grid>
</Window>
