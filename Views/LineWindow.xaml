<Window x:Class="Mandal.Views.LineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mandal.Views"
        xmlns:models="clr-namespace:Mandal.Models"
        Title="Mandal"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Left="0" Top="0" Height="206"
        SizeChanged="Window_SizeChanged" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="#E9DFCE"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#D9CBB3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#C8B698"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="-206"/>
        </Grid.RenderTransform>

        <!-- Panel -->
        <Border Background="{StaticResource PanelBrush}" CornerRadius="0,0,20,20" Margin="0,0,0,22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.35"/>
            </Border.Effect>
        </Border>

        <!-- İp -->
        <Path x:Name="Rope" Stroke="{StaticResource RopeBrush}" StrokeThickness="3" StrokeLineJoin="Round"
              IsHitTestVisible="False" Margin="0,0,0,22"/>
        <Path x:Name="RopeHighlight" Stroke="#55FFFFFF" StrokeThickness="1"
              IsHitTestVisible="False" Margin="0,-1,0,22"/>

        <!-- Uç kancalar -->
        <Ellipse Width="10" Height="10" Fill="#6B7280" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,23,0,0" IsHitTestVisible="False"/>
        <Ellipse Width="10" Height="10" Fill="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,6,0" IsHitTestVisible="False"/>

        <!-- Alıntılar -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Margin="28,14,64,22" PanningMode="HorizontalOnly" Focusable="False"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Top" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ClipItem}">
                        <views:ClipItemView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Boş ip -->
        <TextBlock x:Name="EmptyHint" Foreground="{StaticResource MutedBrush}" FontSize="14" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,22" IsHitTestVisible="False"
                   Visibility="Collapsed">
            İp boş.<LineBreak/>Ctrl+Shift+S ile bölge seç, alıntı buraya asılır. Panoya düşen görüntüler de kendiliğinden asılır.
        </TextBlock>

        <!-- Sağ düğmeler -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,46,16,0">
            <Button Style="{StaticResource RoundButton}" Click="Capture_Click" ToolTip="Bölge al (Ctrl+Shift+S)">
                <Path Data="M4,7 L7,7 L9,4 L15,4 L17,7 L20,7 L20,19 L4,19 Z M12,16 A3.5,3.5 0 1 0 12,9 A3.5,3.5 0 1 0 12,16 Z"
                      Fill="{StaticResource InkBrush}" Stretch="Uniform" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" Click="Hide_Click" ToolTip="İpi kaldır (Ctrl+Shift+Space)" Margin="0,8,0,0">
                <Path Data="M4,15 L12,7 L20,15" Stroke="{StaticResource InkBrush}" StrokeThickness="2.2" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="9"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
