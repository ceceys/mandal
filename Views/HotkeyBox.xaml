<UserControl x:Class="Mandal.Views.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Mandal.Services"
             Focusable="True" Cursor="IBeam" MinWidth="170" Height="30"
             PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp"
             GotKeyboardFocus="OnFocusChanged" LostKeyboardFocus="OnFocusChanged"
             MouseLeftButtonDown="OnMouseDown">
    <Border x:Name="Frame" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,0">
        <Grid>
            <TextBlock x:Name="ValueText" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource InkBrush}" FontFamily="Consolas, Segoe UI"/>
            <TextBlock x:Name="Placeholder" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       Text="{Binding [Settings_HotkeyNone], Source={x:Static svc:Loc.Current}}"/>
        </Grid>
    </Border>
</UserControl>
