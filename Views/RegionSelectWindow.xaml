<Window x:Class="Mandal.Views.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Mandal.Services"
        Title="{Binding [Region_Title], Source={x:Static svc:Loc.Current}}"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="Black" Cursor="Cross" WindowStartupLocation="Manual" ShowActivated="True"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseDown" MouseMove="Window_MouseMove" MouseLeftButtonUp="Window_MouseUp"
        MouseRightButtonDown="Window_RightDown" SizeChanged="Window_SizeChanged">
    <Grid x:Name="Root">
        <Image x:Name="Screenshot" Stretch="Fill"/>

        <!-- Karartma: seçim dışı -->
        <Path Fill="#73000000" IsHitTestVisible="False">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullGeom" Rect="0,0,0,0"/>
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="SelGeom" Rect="0,0,0,0"/>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="SelBorder" Stroke="White" StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed"/>
            <Border x:Name="SizeLabel" Background="#CC1E1E1E" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
            </Border>
        </Canvas>

        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
                Background="#CC1E1E1E" CornerRadius="8" Padding="14,8" IsHitTestVisible="False">
            <TextBlock Foreground="White" FontSize="14" Text="{Binding [Region_Hint], Source={x:Static svc:Loc.Current}}"/>
        </Border>
    </Grid>
</Window>
