<Window x:Class="Mandal.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Mandal.Services"
        Title="Mandal" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Width="520" SizeToContent="Height" WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseDown">

    <Window.Resources>
        <!-- Kart üzerindeki yanıt düğmeleri -->
        <Style x:Key="AnswerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#EFE7D8"/>
            <Setter Property="BorderBrush" Value="#D9CBB3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Notlar alanının ince, kâğıt tonlu kaydırma çubuğu -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#D9CBB3" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Mandaldan sarkan kart; yukarıdan düşer, hafif sallanır. Alt boşluk: eğim ve gölge kırpılmasın. -->
    <Grid x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,26" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="Swing" Angle="-1.5"/>
                <TranslateTransform x:Name="Drop" Y="-60"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="White" Padding="5" CornerRadius="2" Margin="0,-6,0,0" Effect="{StaticResource CardShadow}">
            <Border Background="{StaticResource PaperBrush}" Width="420" Padding="26,22,26,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Grid Width="30" Height="30" VerticalAlignment="Top">
                            <Ellipse Fill="{StaticResource AccentBrush}"/>
                            <TextBlock Text="?" Foreground="White" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                        <TextBlock x:Name="MessageText" Width="322" Margin="14,4,0,0" TextWrapping="Wrap" LineHeight="21"
                                   FontSize="14" Foreground="{StaticResource InkBrush}"/>
                    </StackPanel>

                    <!-- Ayrıntı (ör. sürüm notları): uzunsa kendi içinde kaydırılır, düğmeler hep görünür -->
                    <Border x:Name="DetailsBox" Visibility="Collapsed" Margin="44,0,0,4" Padding="0,10,0,0"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                        <ScrollViewer x:Name="DetailsScroll" MaxHeight="220" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                            </ScrollViewer.Resources>
                            <TextBlock x:Name="DetailsText" TextWrapping="Wrap" LineHeight="19" FontSize="12.5" Margin="0,0,10,0"
                                       Foreground="{StaticResource InkBrush}"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="NoButton" Style="{StaticResource AnswerButton}" Margin="0,0,10,0" Click="No_Click"
                                Content="{Binding [Dialog_No], Source={x:Static svc:Loc.Current}}"/>
                        <Button x:Name="YesButton" Style="{StaticResource AnswerButton}" Click="Yes_Click"
                                Background="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" Foreground="White"
                                Content="{Binding [Dialog_Yes], Source={x:Static svc:Loc.Current}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ContentControl Grid.Row="0" Template="{StaticResource PinTemplate}" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Panel.ZIndex="2" Margin="0,0,0,-6"/>
    </Grid>
</Window>
