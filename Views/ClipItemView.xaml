<UserControl x:Class="Mandal.Views.ClipItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Mandal.Services"
             Margin="{Binding ItemMargin, Source={x:Static svc:LineLayout.Current}}"
             Cursor="Hand" Background="Transparent"
             RenderTransformOrigin="0.5,0"
             ToolTipService.InitialShowDelay="700">
    <UserControl.RenderTransform>
        <RotateTransform Angle="{Binding Tilt}"/>
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Üzerine gelince görünen yuvarlak düğme (sil, metne çevir) -->
        <Style x:Key="HoverCircleButton" TargetType="Button">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
            <MenuItem Header="{Binding [Item_Copy], Source={x:Static svc:Loc.Current}}" Click="Copy_Click"/>
            <MenuItem Header="{Binding [Item_Preview], Source={x:Static svc:Loc.Current}}" Click="Preview_Click"/>
            <MenuItem Header="{Binding [Item_Edit], Source={x:Static svc:Loc.Current}}" Click="Edit_Click"
                      Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="{Binding [Item_OcrTip], Source={x:Static svc:Loc.Current}}" Click="Ocr_Click"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="{Binding [Item_AssignHotkey], Source={x:Static svc:Loc.Current}}" Click="AssignHotkey_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [Item_Open], Source={x:Static svc:Loc.Current}}" Click="Open_Click"/>
            <MenuItem Header="{Binding [Item_SaveAs], Source={x:Static svc:Loc.Current}}" Click="SaveAs_Click"/>
            <MenuItem Header="{Binding [Item_ShowInFolder], Source={x:Static svc:Loc.Current}}" Click="ShowInFolder_Click"/>
            <Separator/>
            <MenuItem Header="{Binding [Item_Delete], Source={x:Static svc:Loc.Current}}" Click="Delete_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kart: beyaz çerçeve; içinde görsel ya da metin notu -->
        <Border x:Name="Photo" Grid.Row="1" Background="White" Padding="4" CornerRadius="2" Margin="0,-6,0,0"
                HorizontalAlignment="Center" SnapsToDevicePixels="True"
                Effect="{StaticResource CardShadow}"
                PreviewMouseLeftButtonDown="Photo_MouseDown"
                PreviewMouseMove="Photo_MouseMove"
                PreviewMouseLeftButtonUp="Photo_MouseUp">
            <Grid>
                <Image x:Name="ThumbImage" Source="{Binding Thumb}"
                       MaxHeight="{Binding ThumbHeight, Source={x:Static svc:LineLayout.Current}}"
                       MaxWidth="{Binding ThumbMaxWidth, Source={x:Static svc:LineLayout.Current}}"
                       MinWidth="36" MinHeight="24"
                       Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>

                <Border Background="{StaticResource PaperBrush}" Padding="8,6"
                        Width="{Binding TextCardWidth, Source={x:Static svc:LineLayout.Current}}"
                        Height="{Binding ThumbHeight, Source={x:Static svc:LineLayout.Current}}"
                        Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                    <!-- Not metni: doğrudan seçilebilir; seçip bırakınca seçim kopyalanır -->
                    <TextBox x:Name="TextCard" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Background="Transparent" BorderThickness="0" Padding="0" Cursor="IBeam"
                             Foreground="{StaticResource InkBrush}" SelectionBrush="{StaticResource AccentBrush}" SelectionOpacity="0.35"
                             FontSize="{Binding TextFontSize, Source={x:Static svc:LineLayout.Current}}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                             ContextMenu="{x:Null}" Focusable="True"/>
                </Border>

                <!-- Atanmış kısayol rozeti -->
                <Border Background="#CC2B2520" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,2,2" IsHitTestVisible="False"
                        Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Hotkey}" Foreground="White" FontSize="10" FontFamily="Consolas, Segoe UI"/>
                </Border>
            </Grid>
        </Border>

        <!-- Mandal: not kartlarında sürükleme tutamağı -->
        <Border x:Name="PinHandle" Grid.Row="0" Background="#01FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top"
                Panel.ZIndex="2" Margin="0,0,0,-6" Padding="4,0"
                PreviewMouseLeftButtonDown="Pin_MouseDown" PreviewMouseMove="Pin_MouseMove" PreviewMouseLeftButtonUp="Pin_MouseUp">
            <ContentControl Template="{StaticResource PinTemplate}">
                <ContentControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding PinScale, Source={x:Static svc:LineLayout.Current}}"
                                    ScaleY="{Binding PinScale, Source={x:Static svc:LineLayout.Current}}"/>
                </ContentControl.LayoutTransform>
            </ContentControl>
        </Border>

        <!-- Sil (sağ üst) -->
        <Button Grid.Row="1" Style="{StaticResource HoverCircleButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-9,0" Panel.ZIndex="3"
                Click="Delete_Click"
                ToolTip="{Binding [Item_DeleteTip], Source={x:Static svc:Loc.Current}}">
            <TextBlock Text="✕" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,-1,0,0"/>
        </Button>

        <!-- Metne çevir (sol üst, yalnız görsel) -->
        <Button Grid.Row="1" Style="{StaticResource HoverCircleButton}" Background="{StaticResource AccentBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,-14,0,0" Panel.ZIndex="3"
                Click="Ocr_Click"
                ToolTip="{Binding [Item_OcrTip], Source={x:Static svc:Loc.Current}}"
                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Aa" Foreground="White" FontSize="9.5" FontWeight="Bold" Margin="0,-1,0,0"/>
        </Button>

        <!-- Önizleme (sol alt): büyük pencerede aç -->
        <Button Grid.Row="1" Style="{StaticResource HoverCircleButton}" Background="{StaticResource InkBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-9,0,0,-9" Panel.ZIndex="3"
                Click="Preview_Click"
                ToolTip="{Binding [Item_Preview], Source={x:Static svc:Loc.Current}}">
            <Path Data="M10,10 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 M14.5,14.5 L20,20 M7,10 L13,10 M10,7 L10,13"
                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="12" Height="12" Stretch="Uniform"/>
        </Button>

        <!-- Kopyalandı -->
        <Border x:Name="CopiedBadge" Grid.Row="1" Background="#D91F8F4A" CornerRadius="12" Padding="12,4" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="4">
            <TextBlock x:Name="CopiedText" Foreground="White" FontWeight="SemiBold" FontSize="13"
                       Text="{Binding [Item_Copied], Source={x:Static svc:Loc.Current}}"/>
        </Border>
    </Grid>
</UserControl>
