<Window x:Class="Mandal.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Mandal.Services"
        Title="Mandal" WindowStyle="None" ResizeMode="CanResize" MinWidth="340" MinHeight="240"
        Background="{StaticResource PanelBrush}" ShowInTaskbar="True" ShowActivated="True"
        Icon="pack://application:,,,/Assets/mandal.ico"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BarButton" TargetType="ButtonBase">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E3D8C3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D4C6AB"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource InkBrush}"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C9B898" BorderThickness="1">
        <DockPanel>
            <!-- Başlık çubuğu: sürüklenebilir -->
            <Grid DockPanel.Dock="Top" Height="38" Background="#F1EADC">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource PinTemplate}" Margin="0,0,10,0">
                        <ContentControl.LayoutTransform>
                            <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                        </ContentControl.LayoutTransform>
                    </ContentControl>
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="FitButton" Style="{StaticResource BarButton}" Click="Fit_Click"
                            ToolTip="{Binding [Preview_FitTip], Source={x:Static svc:Loc.Current}}">
                        <Path Style="{StaticResource BarIcon}" Data="M3,8 L3,3 L8,3 M16,3 L21,3 L21,8 M21,16 L21,21 L16,21 M8,21 L3,21 L3,16"/>
                    </Button>
                    <Button x:Name="ActualButton" Style="{StaticResource BarButton}" Click="Actual_Click"
                            ToolTip="{Binding [Preview_ActualTip], Source={x:Static svc:Loc.Current}}">
                        <TextBlock Text="1:1" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    </Button>
                    <ToggleButton x:Name="PinToggle" Style="{StaticResource BarButton}" Click="Pin_Click"
                                  ToolTip="{Binding [Preview_PinTip], Source={x:Static svc:Loc.Current}}">
                        <Path x:Name="PinIcon" Style="{StaticResource BarIcon}" Data="M9,3 L15,3 L14,9 L18,13 L6,13 L10,9 Z M12,13 L12,21"/>
                    </ToggleButton>
                    <Rectangle Width="1" Height="18" Fill="#D9CBB3" Margin="4,0"/>
                    <Button Style="{StaticResource BarButton}" Click="Copy_Click"
                            ToolTip="{Binding [Preview_CopyTip], Source={x:Static svc:Loc.Current}}">
                        <Path Style="{StaticResource BarIcon}" Data="M8,8 L8,4 L20,4 L20,16 L16,16 M4,8 L16,8 L16,20 L4,20 Z"/>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Click="Open_Click"
                            ToolTip="{Binding [Preview_OpenTip], Source={x:Static svc:Loc.Current}}">
                        <Path Style="{StaticResource BarIcon}" Data="M14,4 L20,4 L20,10 M20,4 L11,13 M18,14 L18,20 L4,20 L4,6 L10,6"/>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Click="Close_Click"
                            ToolTip="{Binding [Preview_CloseTip], Source={x:Static svc:Loc.Current}}">
                        <Path Style="{StaticResource BarIcon}" Data="M5,5 L19,19 M19,5 L5,19"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Durum satırı -->
            <Border DockPanel.Dock="Bottom" Background="#F1EADC" Padding="12,4">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
            </Border>

            <Grid>
                <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="#E9E1D2" Focusable="False"
                              PreviewMouseWheel="Scroll_PreviewMouseWheel"
                              MouseLeftButtonDown="Scroll_MouseLeftButtonDown" MouseMove="Scroll_MouseMove"
                              MouseLeftButtonUp="Scroll_MouseLeftButtonUp" MouseDoubleClick="Scroll_MouseDoubleClick">
                    <Image x:Name="Img" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="12">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
                <TextBox x:Name="TextView" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Visibility="Collapsed" BorderThickness="0" Padding="18,14"
                         Background="{StaticResource PaperBrush}" Foreground="{StaticResource InkBrush}" FontSize="13.5"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
