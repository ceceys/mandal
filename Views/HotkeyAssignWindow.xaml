<Window x:Class="Mandal.Views.HotkeyAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Mandal.Services"
        xmlns:views="clr-namespace:Mandal.Views"
        Title="{Binding [Hotkey_Title], Source={x:Static svc:Loc.Current}}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PanelBrush}"
        FontSize="13" Foreground="{StaticResource InkBrush}" Icon="pack://application:,,,/Assets/mandal.ico">
    <StackPanel Margin="24,18,24,20">
        <TextBlock x:Name="ItemLabel" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding [Hotkey_Help], Source={x:Static svc:Loc.Current}}"/>
        <views:HotkeyBox x:Name="Box" HorizontalAlignment="Left" MinWidth="220"/>
        <TextBlock x:Name="Error" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"
                   Text="{Binding [Hotkey_Conflict], Source={x:Static svc:Loc.Current}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ClearButton" Style="{StaticResource DialogButton}" Margin="0,0,10,0" Click="Clear_Click"
                    Content="{Binding [Hotkey_Clear], Source={x:Static svc:Loc.Current}}"/>
            <Button Style="{StaticResource DialogButton}" Margin="0,0,10,0" IsCancel="True"
                    Content="{Binding [Settings_Cancel], Source={x:Static svc:Loc.Current}}"/>
            <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="Save_Click"
                    Content="{Binding [Settings_Save], Source={x:Static svc:Loc.Current}}"/>
        </StackPanel>
    </StackPanel>
</Window>
