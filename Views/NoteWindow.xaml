<Window x:Class="Mandal.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Mandal.Services"
        Title="Mandal" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Width="600" Height="460" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown" MouseLeftButtonDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="AnswerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="20,7"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="#EFE7D8"/>
            <Setter Property="BorderBrush" Value="#D9CBB3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Mandaldan sarkan not kartı -->
    <Grid x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="Swing" Angle="-1"/>
                <TranslateTransform x:Name="Drop" Y="-60"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="White" Padding="5" CornerRadius="2" Margin="0,-6,0,0" Effect="{StaticResource CardShadow}">
            <Border Background="{StaticResource PaperBrush}" Width="520" Padding="22,16,22,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                   Text="{Binding [Note_Title], Source={x:Static svc:Loc.Current}}"/>
                        <TextBlock x:Name="CharCount" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Çizgili kâğıt hissi: ince alt çizgiler -->
                    <Grid>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="Editor" Height="250" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                     Padding="12,10" FontSize="14" Foreground="{StaticResource InkBrush}"
                                     TextChanged="Editor_TextChanged" SpellCheck.IsEnabled="False"/>
                        </Border>
                        <TextBlock x:Name="Placeholder" Margin="14,11,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                                   Text="{Binding [Note_Placeholder], Source={x:Static svc:Loc.Current}}"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Button x:Name="CopyButton" Style="{StaticResource AnswerButton}" HorizontalAlignment="Left" Click="CopyAll_Click"
                                Content="{Binding [Note_CopyAll], Source={x:Static svc:Loc.Current}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource AnswerButton}" Margin="0,0,10,0" Click="Cancel_Click"
                                    Content="{Binding [Settings_Cancel], Source={x:Static svc:Loc.Current}}"/>
                            <Button x:Name="SaveButton" Style="{StaticResource AnswerButton}" Click="Save_Click"
                                    Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White"
                                    Content="{Binding [Note_Save], Source={x:Static svc:Loc.Current}}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Ctrl+Enter · Esc"/>
                </StackPanel>
            </Border>
        </Border>

        <ContentControl Grid.Row="0" Template="{StaticResource PinTemplate}" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Panel.ZIndex="2" Margin="0,0,0,-6"/>
    </Grid>
</Window>
